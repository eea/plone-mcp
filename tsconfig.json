{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["vitest/globals", "vitest", "node"],
    "baseUrl": ".",
    "paths": {
      "plone-mcp/*": ["./src/*"],
      "xmcp/*": [
        "./node_modules/xmcp/dist/runtime/*",
        "./node_modules/xmcp/dist/*"
      ]
    }
  },
  "include": ["src/**/*.ts", "xmcp-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
