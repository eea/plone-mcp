{
  "name": "plone-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Plone CMS REST API integration",
  "keywords": [
    "mcp",
    "plone",
    "cms",
    "rest-api"
  ],
  "scripts": {
    "build": "xmcp build",
    "type-check:src": "tsc --project tsconfig.json --noEmit",
    "type-check:tests": "tsc --project tsconfig.test.json --noEmit",
    "type-check": "pnpm run type-check:src && pnpm run type-check:tests",
    "test": "vitest run"
  },
  "main": "dist/http.js",
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/inspector": "^0.17.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "isomorphic-fetch": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-supersub": "^1.0.0",
    "unified": "^11.0.5",
    "uuid": "^11.1.0",
    "xmcp": "^0.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/coverage-v8": "^4.0.8",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "nock": "^13.5.0",
    "path": "^0.12.7",
    "prettier": "^3.6.2",
    "supertest": "^6.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@10.22.0"
}
