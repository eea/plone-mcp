{
  "name": "plone-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Plone CMS REST API integration",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "plone-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run copy-blocks-specs && chmod 755 dist/index.js",
    "dev": "tsx src/index.ts",
    "copy-blocks-specs": "copyfiles -u 1 src/blocks.json dist/",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "inspector:built": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest tests/unit",
    "test:unit-only": "vitest tests/unit --coverage",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"{src,tests}/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "plone",
    "cms",
    "rest-api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "isomorphic-fetch": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-supersub": "^1.0.0",
    "unified": "^11.0.5",
    "uuid": "^11.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/coverage-v8": "^4.0.8",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "nock": "^13.5.0",
    "path": "^0.12.7",
    "prettier": "^3.6.2",
    "supertest": "^6.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@9.14.1"
}
